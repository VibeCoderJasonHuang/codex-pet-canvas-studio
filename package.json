{
  "name": "pet-canvas-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"python studio/server.py --port 8787\" \"vite --port 5173\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --pretty false",
    "test": "python -m unittest discover -s tests -v",
    "visual": "python tools/create_visual_fixture.py && node tools/visual_check.mjs",
    "smoke": "python tools/api_smoke.py"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "playwright-core": "^1.49.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
